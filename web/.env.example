# Copy this file to .env.local and fill in the values.
# Never commit .env.local. It holds real keys.

# "sandbox" for testing, "live" for real donations
PAYPAL_ENV=sandbox

# developer.paypal.com > Apps & Credentials > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# developer.paypal.com > your app > Webhooks > the webhook's ID
PAYPAL_WEBHOOK_ID=

# supabase.com > your project > Project Settings > API
SUPABASE_URL=
# The secret (service_role) key. Server only, never put it in browser code.
SUPABASE_SECRET_KEY=
