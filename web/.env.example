# Copy this file to .env.local and fill in the values.
# Never commit .env.local. It holds real keys.

# "sandbox" for testing, "live" for real donations
PAYPAL_ENV=sandbox

# developer.paypal.com > Apps & Credentials > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# developer.paypal.com > your app > Webhooks > the webhook's ID
PAYPAL_WEBHOOK_ID=

# supabase.com > your project > Project Settings > API
SUPABASE_URL=
# The secret (service_role) key. Server only, never put it in browser code.
SUPABASE_SECRET_KEY=

# resend.com > API Keys. Form emails are skipped until this is set.
RESEND_API_KEY=
RESEND_FROM=

# Locks STEP application answers before they are saved. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the same key everywhere and keep a copy somewhere safe: if it is lost,
# saved applications can't be read. The application page stays closed until it is set.
STEP_APPLICATION_KEY=
